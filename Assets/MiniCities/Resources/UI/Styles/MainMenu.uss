:root {
}

.menuButton {
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    background-color: rgb(255, 107, 107);
    border-left-color: rgb(255, 90, 90);
    border-right-color: rgb(255, 90, 90);
    border-top-color: rgb(255, 90, 90);
    border-bottom-color: rgb(255, 90, 90);
    font-size: 48px;
    -unity-text-align: middle-center;
    margin-bottom: 5px;
    -unity-font-style: italic;
    transition-duration: 0.2s;
    margin-top: 5px;
    margin-right: 5px;
    margin-left: 5px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.menuButton:hover {
    display: flex;
    scale: 1.05 1.05;
    rotate: 1deg;
    background-color: rgb(255, 160, 160);
    transition-duration: 0.2s;
    transition-timing-function: ease;
    transition-delay: 0s;
}

.mainMenuDefault {
    flex-grow: 1;
    flex-direction: column;
    left: 600px;
    transition-duration: 0.3s;
    position: absolute;
    top: 125px;
    right: 600px;
    bottom: 125px;
}

.menuContainer {
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-left-color: rgb(77, 77, 77);
    border-right-color: rgb(77, 77, 77);
    border-top-color: rgb(77, 77, 77);
    border-bottom-color: rgb(77, 77, 77);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    background-color: rgb(102, 102, 102);
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    margin-top: 40px;
    margin-right: 40px;
    margin-bottom: 40px;
    margin-left: 40px;
}

.mainMenuOpen {
    translate: -400px 0;
}

.sideMenuDefault {
    flex-grow: 1;
    position: absolute;
    left: 880px;
    top: 125px;
    bottom: 125px;
    right: 200px;
    transition-duration: 0.3s;
    transition-delay: 0s;
    opacity: 0;
    translate: 1100px 0;
}

.sideMenuOpen {
    opacity: 1;
    translate: 0 0;
}

.menuButton:active {
    scale: 0.9 0.9;
    background-color: rgb(255, 237, 237);
}
