:root {
    --testing-color: rgb(255, 0, 0);
}

.defaultText {
    color: rgb(255, 255, 255);
    font-size: 32px;
    -unity-text-align: middle-center;
    -unity-font-style: bold-and-italic;
    text-shadow: 16px 16px 0 rgb(0, 0, 0);
}

.defaultCityStatTab {
    flex-grow: 1;
    width: 25%;
    margin-top: 0;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 0;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.defaultCityStatTabDisplay {
    flex-grow: 1;
    flex-direction: row;
    padding-left: 5px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
}

.displayPlate {
    flex-grow: 1;
    flex-direction: row;
    transition-property: opacity;
    transition-duration: 0.5s;
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    padding-top: 10px;
    padding-right: 5px;
    padding-bottom: 10px;
    padding-left: 5px;
}

.showDisplayPlate {
    opacity: 1;
}
