<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MiniCities/Resources/UI/Styles/MainMenu.uss?fileID=7433441132597879392&amp;guid=471b5c7ea6519ce4f99109d266cdc6a4&amp;type=3#MainMenu"/>
    <ui:VisualElement name="MainMenu" class="mainMenuDefault menuContainer">
        <ui:Label text="Mini Cities" name="TitleLabel" style="font-size: 96px; -unity-text-align: middle-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 255, 255); -unity-font-style: bold; margin-bottom: 40px;"/>
        <ui:VisualElement name="MainMenuButtons" style="flex-grow: 1;">
            <ui:Button text="Play" name="PlayButton" class="button mc-button mainMenuButton menuButton"/>
            <ui:Button text="Options" name="OptionsButton" class="button mc-button mainMenuButton menuButton"/>
            <ui:Button text="Exit" name="ExitButton" class="button mc-button mainMenuButton menuButton"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PlayMenu" enabled="true" class="sideMenuDefault menuContainer">
        <ui:Label text="Configure Game" name="PlayLabel" style="-unity-text-align: middle-left; font-size: 56px; -unity-text-outline-width: 0; -unity-text-outline-color: rgb(255, 255, 255); -unity-font-style: bold; margin-bottom: 30px;"/>
        <ui:VisualElement name="PlayMenuContents" style="flex-grow: 1; flex-direction: column; align-items: stretch; justify-content: flex-start; align-self: stretch;">
            <ui:IntegerField label="Seed" value="0" max-length="11" name="SeedIntegerField" class="menuContainer" style="font-size: 32px; -unity-font-style: italic; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; padding-top: 15px; padding-right: 15px; padding-bottom: 15px; padding-left: 15px; -unity-text-align: middle-center; background-color: rgb(255, 107, 107); border-left-color: rgb(255, 90, 90); border-right-color: rgb(255, 90, 90); border-top-color: rgb(255, 90, 90); border-bottom-color: rgb(255, 90, 90); align-self: auto;"/>
            <ui:VisualElement name="BlueprintFileSelector" style="flex-grow: 0; flex-direction: row; justify-content: center; align-items: center; align-self: stretch; margin-bottom: 30px;">
                <ui:Button text="&lt;" name="BlueprintFileSelectorLeftButton" class="menuButton" style="font-size: 32px;"/>
                <ui:Label text="Label" name="BlueprintFileSelectorLabel" class="menuContainer" style="font-size: 32px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; -unity-text-align: middle-center; -unity-font-style: italic; background-color: rgb(255, 107, 107); border-left-color: rgb(255, 90, 90); border-right-color: rgb(255, 90, 90); border-top-color: rgb(255, 90, 90); border-bottom-color: rgb(255, 90, 90); flex-shrink: 0; flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;"/>
                <ui:Button text="&gt;" name="BlueprintFileSelectorRightButton" class="menuButton" style="font-size: 32px;"/>
            </ui:VisualElement>
            <ui:Button text="Start Game" name="StartGameButton" class="menuButton" style="font-size: 32px;"/>
        </ui:VisualElement>
        <ui:Button name="PlayCloseButton" text="Close" class="menuButton" style="font-size: 24px; width: 130px; margin-bottom: 2px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="OptionsMenu" enabled="true" class="sideMenuDefault menuContainer" style="flex-grow: 1;">
        <ui:Button name="OptionsCloseButton" text="Close" class="menuButton" style="font-size: 24px; width: 130px; margin-bottom: 2px;"/>
    </ui:VisualElement>
</ui:UXML>
